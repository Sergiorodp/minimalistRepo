---
import Layout from '@app/layouts/Layout.astro';

//commponents
import Hero from '@app/sections/Hero.astro';
import About from '@app/sections/About.astro';
import Education from '@app/sections/Education.astro';
import Experience from '@app/sections/Experience.astro';
import Skills from '@app/sections/Skills.astro';
import Certifications from '@app/sections/Certificates.astro';
import KeyWords from '@app/sections/KeyWords.astro';
import { FEATURE_FLAGS } from '@app/utils/featureFlags';

const lang = 'es' as const;
---

<Layout title="Sergio Andres Rodriguez CV - ES">
	<Hero lang={lang}></Hero>
	<About lang={lang}></About>
	<Experience lang={lang}></Experience>
	<Education lang={lang}></Education>
	<Certifications lang={lang}/>
	{FEATURE_FLAGS.showSkillsSection && <Skills lang={lang}/>}
	<KeyWords lang={lang}/>
</Layout>
