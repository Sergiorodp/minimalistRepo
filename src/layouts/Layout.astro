---
import ThemeIcon from "@app/components/icons/ThemeIcon.astro";
import PrintIcon from "@app/components/icons/PrintIcon.astro";
import LogoIcon from "@app/components/icons/LogoIcon.astro";
import LangToggle from "@app/components/icons/LangToggle.astro";
import { getLangFromUrl } from "@app/utils/i18n";
interface Props {
	title: string;
}

const { title } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="layout-container">
			<header class="layout-header"> 
				<div class="themeIcon">
					<div class="logo-container">
						<LogoIcon 
							width="50px"
							height="50px"
						></LogoIcon>
					</div>
					<div class="header-buttons">
						<LangToggle />
						<ThemeIcon label="Change theme aspect"></ThemeIcon>
						<PrintIcon label="Print CV"></PrintIcon>
					</div>
				</div>
				
			</header>
			<div class="container">
				<slot />
			</div>
			<footer>
				<pre>Based on the design by <a href="https://cv.jarocki.me/" target="_blank"><span>Bartosz Jarocki</span></a></pre>
			</footer>
		</div>
	</body>
</html>
<style is:global lang="scss">
	html{
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace;
		--foreground: 224 71.4% 4.1%;
	}

	html.dark{
		background: #0D1117;
	}

	body,
	figure {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	.header-buttons{
		display: flex;
		width: 100%;
		justify-content: flex-end;
		align-items: center;
	}

	footer pre{
		color: black;
		font-size: .7rem;
		max-width: 700px;
		margin: 0 auto;
		display: flex;
		justify-content: end;
		padding: 1rem;

		a{
			color: #1F6FEB;
			:hover{
				color: #113c7b;
			}
		}
	}

	.dark footer{
		color: white;
		a{
			color: #F1CC4C;
			:hover{
				color: #b99e3a;
			}
		}
	}

	.container{
		margin-top: 3rem;
		margin-bottom: 4rem;
	}

	.logo-container{
		margin-right: 3rem;
		display: flex;
		align-items: center;
	}

	.themeIcon{
        display: flex;
        align-items: center;
        top: 0;
        cursor: pointer;

		span{
            margin-left: 1rem;
			color: black;
        }

    }

	.layout-header{
		margin-top: 1rem;
	}

	.dark .themeIcon{
		 span{
			color: white;
		}
	}

	a{
		text-decoration: none;
	}
	ul, li{
		list-style: none;
	}

	*, *::before, *::after{
		box-sizing: border-box;
	}

	@media (prefers-color-sheme: dark){
		html{
			background: #0D1117;
			color: #fff;
		}
	}

	h1, h2, h3, h4 {
		margin: 0;
		font-family: ui-sans-serif, system-ui, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol, Noto Color Emoji;
	}

	.mono {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace;
	}
	.sans-serif {
		font-family: ui-sans-serif, system-ui, sans-serif, Apple Color Emoji, Segoe UI Emoji, Segoe UI Symbol, Noto Color Emoji;
	}

	p, pre{
		text-wrap: pretty;
		font-size: 0.8rem;
		line-height: 1.6;
		margin: 0;
		color: hsl(var(--foreground) / .8);
	}

	.layout-container{
		max-width: 700px;
		margin-left: auto;
		margin-right: auto;
	}

	.dark{
		p,pre{
			color: #cbcbcb;
		}
	}

	@media only screen and (max-width: 738px){
		.layout-container{
			margin-bottom: 1rem;
			padding: 1rem;
			width: 100vw;
		}

		footer pre{
			justify-content: center;
		}

		.layout-header{
			margin-top: 0px;
		}
	}

	@media print{

		@page {
			size: A4;
			margin: 1.5cm;
		}

		html{
			background: #ffffff !important;
			-webkit-print-color-adjust: exact;
			print-color-adjust: exact;
		}
		.container{
			margin-top: 0.5rem !important;
		}
		footer pre{
			display: none !important;
		}

		.layout-header{
			display: none !important;
		}

		.layout-container{
			max-width: 100% !important;
			margin: 0 !important;
			padding: 0 !important;
		}
	}

</style>
