---
import { getCVData } from '@app/utils/cvUtils';

//components
import Section from "@app/components/Section.astro";
import Subtitle from "@app/components/SubTitle.astro"
import Icon from "@app/components/icons/Icon.astro";

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const { basics } = getCVData(lang);

const {name, label, image, location, profiles, telegram, email} = basics
---

<Section>
    <div class="hero-container">
        <div class="header-info">
            <h1 class="name">{name}</h1>
            <Subtitle>{label}</Subtitle>
            <span> 🌐 {location.city}, {location.region}</span>
            <footer>
                <div class="icons">
                    {
                        email && ( 
                                <a href={`mailto:${email}`} title={`Send a email to ${name} at ${email}`} target="_blank" rel="noopener noreferrer">
                                    <Icon icon="email" width="20px" height="20px" />
                                </a>
                            )
                    }
                    {
                        telegram && (
                        <a href={telegram} title={`telegram from ${name}`} target="_blank" rel="noopener noreferrer">
                            <Icon icon="telegram" width="20px" height="20px" />
                        </a>
                        )
                    }
                    {
                        profiles.map(({network, url}) => {
                            return(
                                <a href={url} title={`${network} - ${name} `} target="_blank" rel="noopener noreferrer">
                                    <Icon icon={network.toLowerCase()} width="20px" height="20px" />
                                </a>
                            )
                        })
                    }
                </div>
                <div class="print">
                    {
                        email && <p>{email}</p>
                    }
                    {
                        profiles.map(({url}) => {
                            if(url.includes('linkedin')) 
                                return(
                                    <p>{url}</p>
                                )
                        })
                    }
                </div>
            </footer>
        </div>
        <figure style="display: none;">
            <img src={image} alt={`${name}`} width="200"/>
        </figure>
    </div>
</Section>

<style lang="scss">

    .name{
        color: black;
        font-size: 1.75rem;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        line-height: 1.2;
    }

    :global(.dark){
        .name{
            color: aliceblue;
        }
        span{
            color: rgb(207, 207, 207);
        }
    } 
    span{
        color: grey;
    }

    img{
        position: absolute;
        aspect-ratio: 1/1;
        object-fit: cover;
        width: 200px;
        border-radius: 10px;
    }

    figure{
        display: flex;
        justify-content: center;
    }

    footer .icons{
        display: flex;
        padding: .875rem 0;
        align-items: center;
        justify-content: flex-start;
        gap: 14px;

        a{
            display: flex;
            align-items: center;
            color: #555;
            transition: color 0.2s;

            &:hover{
                color: #000;
            }
        }
    }

    :global(.dark) footer .icons a{
        color: #aaa;

        &:hover{
            color: #fff;
        }
    }

    footer{
        .print{
            margin-top: .5rem;
            display: none;
        }
    }


    @media only screen and (max-width: 600px){

        .name{
            font-size: 1.5rem;
        }

        img{
            aspect-ratio: 1/1;
            object-fit: cover;
            width: 125px;
            border-radius: 10px;
        }

        footer .icons{
            gap: 12px;
        }
    }

    @media only screen and (max-width: 441px){
        figure{
            justify-content: end;
        }

        .themeIcon{
            justify-self: end;
        }

    }
    
    @media print{
        .name{
            color: black !important;
        }       

        .themeIcon{
            display: none;
        }

        footer{
            .print{
                display: block;
            }
            .icons{
                display: none;
            }
        }
    }
</style>

