---
import Section from "@app/components/Section.astro";
import { getCVData } from '@app/utils/cvUtils';
//i18n
import { useTranslations } from '@app/utils/i18n'

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const { basics } = getCVData(lang);
const { summary } = basics

const paraphs = summary.split('\n\n')
const t = useTranslations(lang)
---

<Section title={t('section.about')} hoverColor="blue">
    {
        paraphs.map(paraph => {
            return(
                <p>{paraph}</p>
            )
        })
    }
</Section>

<style>
    div{
        display: flex;
        flex-wrap: wrap;
    }
</style>