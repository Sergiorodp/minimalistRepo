---
import Section from "@app/components/Section.astro"
import CertificatesArticle from "@app/components/CertificatesArticle.astro"

// json cv
import { getCVData } from '@app/utils/cvUtils';
// i18n
import { useTranslations } from '@app/utils/i18n'

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const { certificates } = getCVData(lang);
const t = useTranslations(lang)
const filterCertificates = certificates.slice(0,4)
---

<Section title={t('section.certificates')}>
    {
        filterCertificates.map( ({name, issuer, date}) => {
            return(
                <CertificatesArticle
                    name={name}
                    issuer={issuer}
                    date={date}
                >
                </CertificatesArticle>
            )
        })
    }
    
</Section>