---
import Section from "@app/components/Section.astro";
import Article from "@app/components/ExperienceArticle.astro";
import { work } from "@cv";
import { MONTHS, obtenerFechaActualISO } from "@app/utils/DateFormat";
---

<Section title="Relevant experience" hoverColor="yellow">
    <ul>
        {
            work.map(({name, position, startDate, endDate, summary, skills}) => {
                const startSplit = startDate?.split('-')
                const endDateSplit = endDate?.split('-') ?? obtenerFechaActualISO().split('-')
                startDate = `${startSplit[0]}/${MONTHS[startSplit[1]]}`
                const endDateFormat = `${endDateSplit[0]}/${MONTHS[endDateSplit[1]]}`
                return (
                    <li>
                        <Article
                            name={name}
                            position={position}
                            startDate={startDate}
                            endDate={endDate ? endDateFormat: 'Present'}
                            summary={summary}
                            skills={skills}
                        >
                        </Article>
                    </li>
                )
            })
        }
    </ul>
</Section>

<style>
    ul{
        margin: 0;
        padding: 0;
    }
</style>