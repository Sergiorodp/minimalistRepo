---
import Section from "@app/components/Section.astro";
import Article from "@app/components/ExperienceArticle.astro";
import { getCVData } from '@app/utils/cvUtils';
import { useTranslations } from '@app/utils/i18n';
import { getMonths, obtenerFechaActualISO } from '@app/utils/DateFormat';

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const { work } = getCVData(lang);
const MONTHS = getMonths(lang);
---

<Section title={t('section.experience')} hoverColor="yellow">
    <ul>
        {
            work.map(({name, url, position, startDate, endDate, summary, skills}) => {
                const startSplit = startDate?.split('-')
                const endDateSplit = endDate?.split('-') ?? obtenerFechaActualISO().split('-')
                startDate = `${startSplit[0]}/${MONTHS[startSplit[1]]}`
                const endDateFormat = `${endDateSplit[0]}/${MONTHS[endDateSplit[1]]}`
                return (
                    <li>
                        <Article
                            name={name}
                            url={url}
                            position={position}
                            startDate={startDate}
                            endDate={endDate ? endDateFormat : t('experience.present')}
                            summary={summary}
                            skills={skills}
                            currentLabel={!endDate ? t('work.current') : undefined}
                        >
                        </Article>
                    </li>
                )
            })
        }
    </ul>
</Section>

<style>
    ul{
        margin: 0;
        padding: 0;
    }
</style>