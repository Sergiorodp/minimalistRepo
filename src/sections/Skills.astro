---
import Section from "@app/components/Section.astro";
import SkillGroup from "@app/components/SkillGroup.astro";
import { useTranslations } from '@app/utils/i18n';

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<Section title={t('section.skills')} hoverColor="green" hideSectionOnPrint = {true}>
    <div class="skills-division-container">
        <div class="skills-col-span-2">
            <SkillGroup
            filter="Frontend"
            title={t('skills.frontend')}
            />
        </div>
        <SkillGroup
            filter="Complementary"
            title={t('skills.complementary')}
        />
       <SkillGroup
            title={t('skills.cloud')}
            filter="DevOps"
       />
       <div class="skills-col-span-2">
            <SkillGroup
                filter="Backend"
                title={t('skills.backend')}
            />
       </div>
    </div>
</Section>

<style>
    .skillContainer{
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .skills-division-container{
        display: grid;
        gap: 16px;
        grid-template-columns: repeat(3, 1fr);
    }

    .skills-col-span-2{
        grid-column-end: span 2;
    }

    @media only screen and (max-width: 600px){
        .skills-division-container{
            grid-template-columns: repeat(2, 1fr);
        }
    }

</style>