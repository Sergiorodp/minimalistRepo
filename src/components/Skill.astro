---
import SergiIcon from "@app/components/icons/Icon.astro";
import { fade } from "astro:transitions";
interface Props{
    icon: string | undefined,
    width?: string,
    height?: string,
    background?: string,
    noDarkMode?: boolean
}

const { icon = 'default', width, height, background = '', noDarkMode = false } = Astro.props
---

<div class={`skill ${noDarkMode ? 'no-dark-mode' : ''}`} >
    <SergiIcon icon={icon} width={width}, height={height} background={background} >
    </SergiIcon>
</div>

<style lang="scss">
    .skill{
        padding: 2px;
        border-radius: 10px;
    }

    .no-dark-mode {

        background: white;
    }

    @media print{
        .skill{
            display: none !important;
        }
    }
</style>