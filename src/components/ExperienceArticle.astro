---
import { FONT_COLORS } from "@app/utils/Colors";
import SkillsGrid from "@app/components/SkillsGrid.astro";
import StatusLabel from "@app/components/StatusLabel.astro";

import { skills as cvSkills } from "@cv";

const {name, url, position, startDate, endDate, summary, skills, currentLabel} = Astro.props;

const expSkills = skills
---

<article>
    <header>
        <div>
            <div class="titleRow">
                {url
                    ? <a href={url} target="_blank" rel="noopener noreferrer"><h3>{name}</h3></a>
                    : <h3>{name}</h3>
                }
                {currentLabel && <StatusLabel text={currentLabel} />}
            </div>
            <h4 class="mono">{position}</h4>
        </div>
        <span class="">{`${startDate} - ${endDate}`}</span>
    </header>
    <p>{summary}</p>
    <SkillsGrid skills={expSkills}>
    </SkillsGrid>
</article>

<style lang="scss" define:vars={{lightSub: FONT_COLORS.subtitle.light, darkSub: FONT_COLORS.subtitle.dark}}>
    header{
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        margin-bottom: 0.5rem;
    }

    header > div{
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.3rem;
    }

    .titleRow{
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
        flex-wrap: nowrap;
        white-space: nowrap;
    }

    article{
        margin-bottom: 1.25rem;
    }

    span{
        padding: 0px 1rem 0px 0px;
        display: flex;
        justify-content: end;
        font-size: 0.75rem;
        color: #7a7a7a;
    }

    h3{
        color: #2c2c2c;
        font-size: 0.9rem;
        white-space: nowrap;
    }

    .titleRow a{
        text-decoration: none;
        color: inherit;

        &:hover h3{
            text-decoration: underline;
            text-underline-offset: 2px;
        }
    }

    h4{
        margin-top: .25rem;
        color: var(--lightSub);
        font-size: 0.8rem;
    }

    p{
        font-size: 0.8rem;
    }

    :global(.dark){
            h3{
                color: rgb(255, 255, 255);
            }
            
            h4{
                color: var(--darkSub);
                font-size: 0.8rem;
            }
            span{
                color: rgb(220, 219, 219);
            }
        }

    @media only screen and (max-width: 600px){
        span{
            font-size: .9rem;
        }
    }

    @media print{
        header{
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            margin-bottom: 0.5rem;
        }

        article{
            margin-bottom: 0.75rem;
            break-inside: avoid;
            page-break-inside: avoid;
        }

        span{
            color: #6d6d6d !important;
        }

        h3{
            color: #2c2c2c !important;
        }

        h4{
            color: #949494 !important;
        }

        p{
            font-size: .8rem;
        }
    }
</style>