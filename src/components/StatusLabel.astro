---
const { text } = Astro.props;
---

<div>
    <label class="mono">{text}</label>
</div>

<style lang="scss">
    div {
        display: flex;
        width: fit-content;
        padding: .2rem .5rem;
        background-color: var(--status-background-color, #2e7d32);
        border-radius: 3px;
        flex-shrink: 0;
    }
    label{
        font-size: 0.75rem;
        font-weight: 600;
        color: #f0f0f0;
        white-space: nowrap;
    }
    :global(.dark){
        div {
            background-color: var(--status-background-color-dark, #4caf50);
        }
        label{
            color: var(--status-text-color-dark, #0d1f0d);
        }
    }
    @media print {
        div {
            box-shadow: none;
        }
    }
</style>
