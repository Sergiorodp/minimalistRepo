---
import Skill from "@app/components/SkillLabel.astro";
import { type ISkill } from '@app/types/skillTypes'

interface Props {
    skills: ISkill[]
}

const { skills = [] } = Astro.props
const areSkills = skills?.length > 0 ? 'flex' : 'none'
---

<div class="skillContainer">
    {
        skills.map((name)=>{
                return(
                    <Skill skill={name}/>
                )
        })
    }
</div>

<style lang="scss" define:vars={{ areSkills: areSkills }}>
    .skillContainer{
        margin-top: .5rem;
        flex-wrap: wrap;
        gap: 0.313rem;
    }

    .skillContainer{
        display: var(--areSkills, 'flex');
    }
</style>