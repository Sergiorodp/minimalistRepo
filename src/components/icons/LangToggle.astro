---
import { getLangFromUrl } from '@app/utils/i18n';

const lang = getLangFromUrl(Astro.url);
const isEn = lang === 'en';
const href = isEn ? '/es/' : '/';
const label = isEn ? 'ES' : 'EN';
---

<a
  href={href}
  class="lang-toggle"
  aria-label={`Switch to ${isEn ? 'Spanish' : 'English'}`}
  title={`Switch to ${isEn ? 'Español' : 'English'}`}
>
  {label}
</a>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid currentColor;
    background: none;
    cursor: pointer;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Courier New', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    color: black;
    border-radius: 4px;
    width: 32px;
    height: 32px;
    text-decoration: none;
    transition: opacity 0.2s;
    margin: 0 4px;
  }

  .lang-toggle:hover {
    opacity: 0.7;
  }

  :global(.dark) .lang-toggle {
    color: white;
    border-color: white;
  }

  @media print {
    .lang-toggle {
      display: none;
    }
  }
</style>
