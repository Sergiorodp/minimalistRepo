---
const { skill } = Astro.props;
---

<div>
    <p>{skill}</p>
</div>

<style lang="scss">
    div {
        padding: 0 .5rem;
        background-color: var(--skill-background-color, #f0f0f0);
        border-radius: 10%;
        margin-bottom: 1rem;
    }

    p {
        font-size: 0.625rem;
        font-weight: 600;
    }

     :global(.dark){ 

        div {
            background-color: var(--skill-background-color-dark, #2d2d2d);
        }

        p{
            color: var(--skill-text-color-dark, #f0f0f0);
        }
        
     }

    @media print {
        div {
            box-shadow: none;
        }
    }
</style>